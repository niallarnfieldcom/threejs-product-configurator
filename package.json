{
  "name": "threejs-product-configurator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check.mjs",
    "dev:authoring": "vite --host 127.0.0.1 --port 5174 --open /authoring.html",
    "prepare:scene": "blender --background --factory-startup --python tools/prepare-scene.py --"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "playcanvas": "^2.21.4",
    "qrcode": "^1.5.4",
    "three": "0.183.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "description": "A realistic 3D product configurator for three.js: a live renderer while you move, a path-traced photo render when you stop.",
  "author": "Niall Arnfield (https://niallarnfield.com)",
  "homepage": "https://github.com/niallarnfieldcom/threejs-product-configurator",
  "license": "SEE LICENSE IN LICENSE"
}
