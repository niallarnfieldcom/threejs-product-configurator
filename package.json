{
  "name": "threejs-product-configurator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "node --test test/*.test.mjs",
    "validate:catalogue": "node tools/validate-catalogue.mjs",
    "check": "node tools/check.mjs",
    "check:build": "node tools/check-build.mjs",
    "dev:authoring": "vite --configLoader runner --host 127.0.0.1 --port 5174",
    "generate:products": "blender --background --factory-startup --python tools/generate-sample-products.py"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "playcanvas": "^2.21.4",
    "qrcode": "^1.5.4",
    "three": "0.183.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "ktx2-encoder": "^0.5.3",
    "sharp": "^0.34.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "description": "A data-driven 3D product configurator for three.js: multi-slot finishes, path-traced Photo Mode, AR, share links and embed messaging.",
  "author": "Niall Arnfield (https://niallarnfield.com)",
  "homepage": "https://github.com/niallarnfieldcom/threejs-product-configurator"
}
